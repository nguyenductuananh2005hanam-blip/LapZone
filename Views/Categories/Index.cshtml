@model IEnumerable<Lapzone_test.Models.Category>

@{
    ViewData["Title"] = "Quản lý danh mục";
    // Layout = "~/Views/Shared/_AdminLayout.cshtml";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@if (ViewBag.ErrorMessage != null)
{
    <script>
        alert(@Json.Serialize(ViewBag.ErrorMessage));
    </script>
}

@if (ViewBag.Success != null)
{
    <script>
        alert(@Json.Serialize(ViewBag.Success));
    </script>
}

<style>
    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .card-header h1 {
            margin: 0;
        }

        .card-header a.btn {
            margin-left: 10px;
        }
</style>
<div class="card-header">
    <h1>Quản lý danh mục</h1>
    <span>
        <a asp-controller="Categories" asp-action="Create" class="btn btn-primary">Thêm danh mục</a>
    </span>
</div>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                #@Html.DisplayFor(model => item.Id)
            </td>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a> |
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này?')">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>
