                @Html.DisplayFor(model => item.Os)
            </td>
            <td>
                @Html.DisplayFor(model => item.ConditionStatus)
            </td>
            <td>
                @Html.DisplayFor(model => item.Warranty)
            </td>
            <td>
                @Html.DisplayFor(model => item.MoreInfo)
            </td>
            <td>
                @Html.DisplayFor(model => item.ProductId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Product)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
