@model Lapzone_test.Models.User

@{
    ViewData["Title"] = "Thay đổi thông tin";
}

<style>
    .profile-card {
        background: #fff;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 20px rgba(15, 23, 42, .08);
    }

    .profile-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--ink);
        margin-bottom: .25rem;
        text-align : center;
    }

    .profile-sub {
        color: #64748b;
        font-size: .92rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #edf0f5;
        text-align: center;
    }

    .profile-card .form-group {
        margin-bottom: 1.15rem;
    }

    .profile-card label {
        display: block;
        margin-bottom: .4rem;
        font-size: .9rem;
        font-weight: 600;
        color: #475569;
    }

        .profile-card label::before {
            color: var(--brand);
            margin-right: .5rem; 
            font-size: 1.05rem;
            vertical-align: -2px;
        }

    .profile-card .form-control {
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        padding: .65rem .9rem;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .profile-card .form-control:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .12);
        }

    .profile-card .input-validation-error {
        border-color: #dc3545;
    }

    .profile-card .field-validation-error {
        display: block;
        margin-top: .3rem;
        font-size: .82rem;
    }

    /* Nút */
    .profile-card .form-group:last-child {
        display: flex;
        gap: .6rem;
        margin: 1.75rem 0 0;
    }

    .profile-card .btn {
        border-radius: 999px;
        padding: .6rem 1.6rem;
        font-weight: 600;
    }

    .profile-card .btn-primary {
        background: var(--brand);
        border-color: var(--brand);
    }

        .profile-card .btn-primary:hover {
            background: var(--brand-dark);
            border-color: var(--brand-dark);
        }
    .btn_group{
        display : flex;
        justify-content : space-between;
        padding: 0.5rem 1.5rem;
    }

        .btn_group .btn {
            width: 48%;
            font-weight : bold;
        }
</style>

<hr />
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="profile-card">
            <h2 class="profile-title">Thông tin người dùng</h2>
            <p class="profile-sub">Cập nhật thông tin liên hệ của bạn</p>
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="form-group">
                    <label asp-for="FullName" class="bi bi-person-circle me-2 control-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Email" class="bi bi-envelope me-2 control-label"></label>
                    <input asp-for="Email" class="form-control" disabled />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Phone" class="bi bi-telephone me-2 control-label"></label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Address" class="bi bi-geo-alt me-2 control-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                <div class="btn_group form-group">
                    <input type="submit" value="Cập nhật" class="btn btn-primary" />
                    <a href="javascript:history.back()" class="btn btn-secondary">Hủy</a>
                </div>
            </form>          
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
