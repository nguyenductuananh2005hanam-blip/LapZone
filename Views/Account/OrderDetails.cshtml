@model Lapzone_test.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
    var details = Model.OrderDetails ?? new List<Lapzone_test.Models.OrderDetail>();
}

<style>
    .od-card {
        background: #fff;
        border-radius: 16px;
        padding: 1.75rem;
        box-shadow: 0 4px 20px rgba(15, 23, 42, .08);
    }

    .od-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 1.25rem;
        padding-bottom: .8rem;
        border-bottom: 1px solid #edf0f5;
    }

    .od-table th {
        font-size: .82rem;
        text-transform: uppercase;
        letter-spacing: .03em;
        color: #64748b;
        font-weight: 700;
        border-bottom: 2px solid #edf0f5;
    }

    .od-table td {
        padding: .9rem .5rem;
        border-color: #edf0f5;
    }

    .od-product {
        font-weight: 600;
        color: var(--ink);
    }

    .od-info {
        display: flex;
        gap: .75rem;
        margin-bottom: 1rem;
    }

        .od-info i {
            color: var(--brand);
            font-size: 1.15rem;
            margin-top: .1rem;
        }

        .od-info small {
            display: block;
            color: #64748b;
            font-size: .8rem;
        }

        .od-info span {
            font-weight: 600;
            color: var(--ink);
        }

    .od-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px dashed #e2e8f0;
        font-weight: 800;
    }

        .od-total span:last-child {
            color: #dc3545;
            font-size: 1.3rem;
        }

    .od-back {
        border-radius: 999px;
        font-weight: 600;
    }
</style>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h2 class="fw-bold mb-0" style="color:var(--ink)">
        <i class="bi bi-receipt me-2 text-primary"></i>Đơn hàng #@Model.Id
    </h2>
    <a asp-action="OderDetails" asp-controller="CartItems" class="btn btn-outline-secondary od-back">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
</div>

<div class="row g-4">

    <!-- Danh sách sản phẩm -->
    <div class="col-lg-8">
        <div class="od-card">
            <h5 class="od-title"><i class="bi bi-box-seam me-2 text-primary"></i>Sản phẩm đã đặt</h5>

            <div class="table-responsive">
                <table class="table od-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-center">SL</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in details)
                        {
                            <tr>
                                <td class="od-product">@d.Product?.Name</td>
                                <td class="text-end">@d.Price.ToString("N0") đ</td>
                                <td class="text-center">@d.Quantity</td>
                                <td class="text-end fw-semibold">@((d.Price * d.Quantity).ToString("N0")) đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="od-total">
                <span>Tổng cộng</span>
                <span>@Model.TotalAmount.ToString("N0") đ</span>
            </div>
        </div>
    </div>

    <!-- Thông tin giao hàng -->
    <div class="col-lg-4">
        <div class="od-card">
            <h5 class="od-title"><i class="bi bi-truck me-2 text-primary"></i>Thông tin giao hàng</h5>

            <div class="od-info">
                <i class="bi bi-calendar-event"></i>
                <div>
                    <small>Ngày đặt</small>
                    <span>@Model.OrderDate</span>
                </div>
            </div>
            <div class="od-info">
                <i class="bi bi-person"></i>
                <div>
                    <small>Người nhận</small>
                    <span>@Model.CustomerName</span>
                </div>
            </div>
            <div class="od-info">
                <i class="bi bi-telephone"></i>
                <div>
                    <small>Số điện thoại</small>
                    <span>@Model.CustomerPhone</span>
                </div>
            </div>
            <div class="od-info">
                <i class="bi bi-geo-alt"></i>
                <div>
                    <small>Địa chỉ</small>
                    <span>@Model.Address</span>
                </div>
            </div>
            <div class="od-info mb-0">
                <i class="bi bi-cash-coin"></i>
                <div>
                    <small>Thanh toán</small>
                    <span>Thanh toán khi nhận hàng (COD)</span>
                </div>
            </div>
        </div>
    </div>
</div>
