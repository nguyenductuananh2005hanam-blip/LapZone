@model Lapzone_test.Models.User
@{
    ViewData["Title"] = "Thay đổi mật khẩu";
}

<style>
    .pw-card {
        background: #fff;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 20px rgba(15, 23, 42, .08);
    }

    .pw-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--ink);
        text-align: center;
        margin-bottom: .25rem;
    }

    .pw-sub {
        color: #64748b;
        font-size: .92rem;
        text-align: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #edf0f5;
    }

    .pw-card label {
        display: block;
        margin-bottom: .4rem;
        font-size: .9rem;
        font-weight: 600;
        color: #475569;
    }

        .pw-card label::before {
            color: var(--brand);
            margin-right: .5rem;
            font-size: 1.05rem;
            vertical-align: -2px;
        }

    .pw-field {
        position: relative;
    }

    .pw-card .form-control {
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        padding: .65rem 2.8rem .65rem .9rem;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .pw-card .form-control:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .12);
        }

    .pw-toggle {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        border: none;
        background: none;
        color: #94a3b8;
        font-size: 1.15rem;
        padding: .25rem .4rem;
        cursor: pointer;
    }

        .pw-toggle:hover {
            color: var(--brand);
        }

    /* Hai nút */
    .btn-gr {
        display: flex;
        gap: .6rem;
        margin-top: 1.75rem;
    }

        .btn-gr .btn {
            flex: 1;
            border-radius: 999px;
            padding: .65rem 1rem;
            font-weight: 700;
        }

        .btn-gr .btn-primary {
            background: var(--brand);
            border-color: var(--brand);
        }

            .btn-gr .btn-primary:hover {
                background: var(--brand-dark);
                border-color: var(--brand-dark);
            }

    /* Thông báo */
    .pw-card .alert {
        border: none;
        border-radius: 10px;
        font-size: .92rem;
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <div class="pw-card">
            <h2 class="pw-title">Thay đổi mật khẩu</h2>
            <p class="pw-sub">Nhập mật khẩu hiện tại và mật khẩu mới của bạn</p>
            
                @if (ViewBag.Error != null)
                {
                    <script>
                                    alert(@Json.Serialize(ViewBag.Error));
                    </script>
                }
                @if (ViewBag.Success != null)
                {
                    <script>
                                    alert(@Json.Serialize(ViewBag.Success));
                    </script>
                }
            
            <form asp-action="ChangesPassword" asp-route-id="@Model.Id" method="post">
                <div class="mb-3">
                    <label class="bi bi-key">Mật khẩu hiện tại</label>
                    <div class="pw-field">
                        <input type="password" name="currentPassword" class="form-control" required />
                        <button type="button" class="pw-toggle" aria-label="Hiện/ẩn mật khẩu"><i class="bi bi-eye"></i></button>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="bi bi-lock">Mật khẩu mới</label>
                    <div class="pw-field">
                        <input type="password" name="newPassword" class="form-control" required  />
                        <button type="button" class="pw-toggle" aria-label="Hiện/ẩn mật khẩu"><i class="bi bi-eye"></i></button>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="bi bi-shield-lock">Xác nhận mật khẩu mới</label>
                    <div class="pw-field">
                        <input type="password" name="confirmPassword" class="form-control" required />
                        <button type="button" class="pw-toggle" aria-label="Hiện/ẩn mật khẩu"><i class="bi bi-eye"></i></button>
                    </div>
                </div>

                <div class="btn-gr">
                    <button type="submit" class="btn btn-primary">Thay đổi mật khẩu</button>
                    <a href="javascript:history.back()" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.pw-toggle').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var input = btn.parentElement.querySelector('input');
                var icon = btn.querySelector('i');
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        });
    </script>
}