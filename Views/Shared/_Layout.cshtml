@{
    var userId = Context.Session.GetString("UserId");
    var userName = Context.Session.GetString("UserName");
    var isAdmin = Context.Session.GetString("UserRole") == "Admin";
    var cartCount = Context.Session.GetInt32("CartCount") ?? 0;

    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var act = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string a) => (ctrl == c && act == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lapzone</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Lapzone_test.styles.css" asp-append-version="true" />
</head>

<body>
    <style>
            :root {
                --brand: #0d6efd;
                --brand-dark: #0a58ca;
                --ink: #1e293b;
            }

            body {
                background: #f5f7fb;
                color: var(--ink);
            }

            
            .top-strip {
                background: #0f172a;
                color: #cbd5e1;
                font-size: .82rem;
                padding: .4rem 0;
            }

            
            .site-header {
                background: #fff;
                box-shadow: 0 2px 10px rgba(0, 0, 0, .06);
                z-index: 1030;
            }

            .brand-icon {
                font-size: 1.9rem;
                color: var(--brand);
                margin-right: .45rem;
            }

            .brand-text {
                font-size: 1.6rem;
                font-weight: 800;
                color: var(--ink);
                letter-spacing: -.5px;
            }

                .brand-text span {
                    color: var(--brand);
                }

            
            .search-box {
                position: relative;
                max-width: 560px;
                min-width: 240px;
            }

                .search-box .form-control {
                    border-radius: 999px;
                    padding: .65rem 3rem .65rem 1.2rem;
                    border: 2px solid #e2e8f0;
                }

                    .search-box .form-control:focus {
                        border-color: var(--brand);
                        box-shadow: none;
                    }

                .search-box button {
                    position: absolute;
                    right: 6px;
                    top: 50%;
                    transform: translateY(-50%);
                    border: none;
                    background: var(--brand);
                    color: #fff;
                    width: 38px;
                    height: 38px;
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    transition: background-color .2s ease;
                }

                    .search-box button:hover {
                        background: var(--brand-dark);
                    }

            /* Nút giỏ hàng, tài khoản */
            .header-action {
                display: flex;
                align-items: center;
                gap: .45rem;
                padding: .5rem .9rem;
                border-radius: 999px;
                color: var(--ink);
                text-decoration: none;
                font-weight: 500;
                transition: background-color .2s ease, color .2s ease;
            }

                .header-action i {
                    font-size: 1.35rem;
                }

                .header-action:hover {
                    background: #e7f0ff;
                    color: var(--brand);
                }

                .header-action.dropdown-toggle::after {
                    margin-left: .2rem;
                }

            .cart-badge {
                position: absolute;
                top: -2px;
                left: 1.4rem;
                font-size: .65rem;
            }

            /* Menu chính */
            .main-nav {
                padding: 0;
                border-top: 1px solid #edf0f5;
            }

                .main-nav .nav-link {
                    color: #475569;
                    font-weight: 500;
                    padding: .8rem 1.1rem;
                    border-bottom: 3px solid transparent;
                    transition: color .2s ease, border-color .2s ease;
                }

                    .main-nav .nav-link:hover,
                    .main-nav .nav-link.active {
                        color: var(--brand);
                        border-bottom-color: var(--brand);
                    }
            

            /* Footer */
            .site-footer {
                background: #0f172a;
                color: #cbd5e1;
                margin-top: 3rem;
            }

            .footer-brand {
                font-size: 1.5rem;
                font-weight: 800;
                color: #fff;
            }

                .footer-brand i {
                    color: var(--brand);
                }

            .footer-text {
                font-size: .92rem;
                color: #94a3b8;
            }

            .footer-title {
                color: #fff;
                font-weight: 700;
                margin-bottom: 1rem;
            }

            .footer-links, .footer-contact {
                list-style: none;
                padding: 0;
                margin: 0;
            }

                .footer-links li {
                    margin-bottom: .55rem;
                }

                .footer-links a {
                    color: #94a3b8;
                    text-decoration: none;
                    transition: color .2s ease, padding-left .2s ease;
                }

                    .footer-links a:hover {
                        color: #fff;
                        padding-left: 4px;
                    }

                .footer-contact li {
                    display: flex;
                    gap: .6rem;
                    margin-bottom: .6rem;
                    color: #94a3b8;
                    font-size: .92rem;
                }

                .footer-contact i {
                    color: var(--brand);
                }

            .footer-social {
                display: flex;
                gap: .6rem;
                margin-top: 1rem;
            }

                .footer-social a {
                    width: 38px;
                    height: 38px;
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    background: #1e293b;
                    color: #cbd5e1;
                    text-decoration: none;
                    transition: background-color .2s ease, transform .2s ease;
                }

                    .footer-social a:hover {
                        background: var(--brand);
                        color: #fff;
                        transform: translateY(-3px);
                    }

            .footer-bottom {
                border-top: 1px solid #1e293b;
                padding: 1rem 0;
                font-size: .85rem;
                color: #64748b;
            }

            /* Nút lên đầu trang */
            .back-to-top {
                position: fixed;
                right: 20px;
                bottom: 20px;
                width: 44px;
                height: 44px;
                border: none;
                border-radius: 50%;
                background: var(--brand);
                color: #fff;
                font-size: 1.2rem;
                box-shadow: 0 6px 18px rgba(13, 110, 253, .4);
                opacity: 0;
                visibility: hidden;
                transform: translateY(10px);
                transition: opacity .25s ease, transform .25s ease, visibility .25s;
                z-index: 1040;
            }

                .back-to-top.show {
                    opacity: 1;
                    visibility: visible;
                    transform: translateY(0);
                }
    </style>
    <!-- Thanh thông tin trên cùng -->
    @* <div class="top-strip d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <span><i class="bi bi-truck me-1"></i>Miễn phí giao hàng cho đơn từ 10 triệu</span>
            <span>
                <i class="bi bi-telephone me-1"></i>Hotline: 1900 0000
                <span class="mx-2">|</span>
                <i class="bi bi-envelope me-1"></i>contact@lapzone.vn
            </span>
        </div>
    </div> *@

    <!-- Header chính -->
    <header class="site-header sticky-top">
        <div class="container">
            <div class="d-flex align-items-center flex-wrap gap-3 py-3">

                <!-- Logo -->
                <a class="brand d-flex align-items-center text-decoration-none"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-laptop brand-icon"></i>
                    <span class="brand-text">Lap<span>zone</span></span>
                </a>

                <!-- Tìm kiếm -->
                <form class="search-box flex-grow-1 order-3 order-md-2"
                      asp-controller="Home" asp-action="DsSanPham" method="get">
                    <input type="text" name="keyword" class="form-control"
                           placeholder="Tìm laptop, hãng, cấu hình..." />
                    <button type="submit" aria-label="Tìm kiếm"><i class="bi bi-search"></i></button>
                </form>

                <!-- Giỏ hàng + tài khoản -->
                <div class="d-flex align-items-center gap-2 ms-auto order-2 order-md-3">

                    <a class="header-action position-relative"
                       asp-area="" asp-controller="CartItems" asp-action="Index" title="Giỏ hàng">
                        <i class="bi bi-cart3"></i>
                        <span class="d-none d-lg-inline">Giỏ hàng</span>
                        @if (cartCount > 0)
                        {
                            <span class="cart-badge badge rounded-pill bg-danger">
                                @(cartCount > 99 ? "99+" : cartCount.ToString())
                            </span>
                        }
                    </a>

                    @if (userId == null)
                    {
                        <a class="header-action" asp-area="" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-person-circle"></i>
                            <span class="d-none d-lg-inline">Đăng nhập</span>
                        </a>
                    }
                    else
                    {
                        <div class="dropdown">
                            <a class="header-action dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                                <span class="d-none d-lg-inline">@userName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow rounded-3">
                                <li><span class="dropdown-item-text text-muted small">Xin chào, <strong>@userName</strong></span></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile" asp-route-id="@userId">
                                        <i class="bi bi-person me-2"></i>Thông tin tài khoản
                                    </a>
                                    <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangesPassword" asp-route-id="@userId">
                                        <i class="bi bi-key me-2"></i>Thay đổi mật khẩu
                                    </a>
                                    <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Orders">
                                        <i class="bi bi-list-check me-2"></i>Thông tin đơn hàng
                                    </a>
                                    <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Menu chính -->
        <nav class="navbar navbar-expand-lg main-nav">
            <div class="container">
                <button class="navbar-toggler ms-auto my-1" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link @Active("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Active("Home", "DsDanhMuc")" asp-area="" asp-controller="Home" asp-action="DsDanhMuc">
                                <i class="bi bi-grid me-1"></i>Danh mục sản phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Active("Home", "About")" asp-area="" asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle me-1"></i>Về chúng tôi
                            </a>
                        </li>
                    </ul>

                    @if (isAdmin)
                    {
                        <ul class="navbar-nav ms-lg-auto">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-primary fw-bold" href="#" id="adminDropdown"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear-fill me-1"></i>Quản trị
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow rounded-3" aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Categories" asp-action="Index">
                                            <i class="bi bi-tags me-2"></i>Quản lý danh mục
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Users" asp-action="Index">
                                            <i class="bi bi-people me-2"></i>Quản lý tài khoản
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Products" asp-action="Index">
                                            <i class="bi bi-laptop me-2"></i>Quản lý sản phẩm
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Orders" asp-action="Index">
                                            <i class="bi bi-receipt me-2"></i>Quản lý đơn hàng
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item fw-bold text-primary" asp-controller="AdminThongKe" asp-action="Index">
                                            <i class="bi bi-graph-up-arrow me-2"></i>Thống kê doanh thu
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>

       
        @* @await Component.InvokeAsync("CategoryMenu") *@
    </header>

    @* @await RenderSectionAsync("Hero", required: false) *@

    
    <div class="container">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="row g-4 py-5">

                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand mb-3"><i class="bi bi-laptop me-2"></i>Lapzone</div>
                    <p class="footer-text">
                        Cửa hàng laptop, đa dạng cấu hình, giá tốt cho học tập, văn phòng và giải trí.
                    </p>
                    <div class="footer-social">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                        <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                        <a href="#" aria-label="Zalo"><i class="bi bi-chat-dots"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="footer-title">Khám phá</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li><a asp-controller="Home" asp-action="DsDanhMuc">Danh mục sản phẩm</a></li>
                        <li><a asp-controller="Home" asp-action="About">Về chúng tôi</a></li>
                        <li><a asp-controller="CartItems" asp-action="Index">Giỏ hàng</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="footer-title">Hỗ trợ khách hàng</h6>
                    <ul class="footer-links">
                        <li><a href="#">Chính sách bảo hành</a></li>
                        <li><a href="#">Chính sách đổi trả</a></li>
                        <li><a href="#">Hướng dẫn mua hàng</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="footer-title">Liên hệ</h6>
                    <ul class="footer-contact">
                        <li><i class="bi bi-geo-alt"></i>Ninh Bình</li>
                        <li><i class="bi bi-telephone"></i>0383861262</li>
                        <li><i class="bi bi-envelope"></i>nguyenductuananh@gmail.com</li>
                        <li><i class="bi bi-clock"></i>8:00 - 21:00 (T2 - CN)</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="container d-flex flex-wrap justify-content-between gap-2">
                <span>&copy; @DateTime.Now.Year</span>
                @* <span>Thiết kế bởi Lapzone_test</span> *@
            </div>
        </div>
    </footer>

    
    <button id="backToTop" class="back-to-top" type="button" aria-label="Lên đầu trang">
        <i class="bi bi-arrow-up"></i>
    </button>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
            (function() {
                var btn = document.getElementById('backToTop');
                window.addEventListener('scroll', function() {
                    btn.classList.toggle('show', window.scrollY > 300);
                });
                btn.addEventListener('click', function() {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
