@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string c) => string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Lapzone Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>
            body.admin {
                margin: 0;
                display: flex;
                min-height: 100vh;
                background: #f8f9fa
            }

            /* Sidebar */
            .sidebar {
                width: 280px;
                flex-shrink: 0;
                position: sticky;
                top: 0;
                height: 100vh;
                display: flex;
                flex-direction: column;
                background: #2c3e50
            }

            .sidebar-brand {
                display: block;
                padding: 30px 16px;
                background: #1f2d3a;
                text-align: center;
                text-decoration: none;
                font-size: 1.35rem;
                font-weight: 700;
                letter-spacing: 1px;
                text-transform: uppercase;
                color: #1abc9c
            }

                .sidebar-brand:hover {
                    color: #1abc9c
                }

            .sidebar-menu {
                flex: 1;
                margin: 0;
                padding: 12px 0;
                list-style: none
            }

                .sidebar-menu a {
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    padding: 14px 28px;
                    color: #ecf0f1;
                    text-decoration: none;
                    transition: background-color .15s
                }

                    .sidebar-menu a i {
                        width: 20px;
                        text-align: center
                    }

                    .sidebar-menu a:hover {
                        background: #34495e;
                        color: #fff
                    }

                    .sidebar-menu a.active {
                        background: #34495e;
                        box-shadow: inset 4px 0 0 #1abc9c
                    }

            .sidebar-foot {
                padding: 12px 0;
                border-top: 1px solid rgba(255,255,255,.1)
            }

                .sidebar-foot a {
                    display: flex;
                    align-items: center;
                    gap: 14px;
                    padding: 14px 28px;
                    color: #e74c3c;
                    text-decoration: none
                }

                    .sidebar-foot a:hover {
                        background: #34495e;
                        color: #ff6b5b
                    }

            /* Nội dung */
            .admin-main {
                flex: 1;
                min-width: 0;
                padding: 48px 36px
            }

            .admin-card {
                background: #fff;
                border-radius: 6px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08)
            }

            .admin-card-head {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                padding: 18px 20px;
                border-bottom: 1px solid #dee2e6
            }

                .admin-card-head h1 {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    margin: 0;
                    font-size: 1.4rem;
                    font-weight: 700;
                    text-transform: uppercase;
                    color: #0d6efd
                }

            .admin-card-body {
                padding: 18px 20px 24px;
                overflow-x: auto
            }

            /* Bảng */
            .admin-table th {
                text-align: center;
                background: #f8f9fa
            }

            .admin-table td {
                vertical-align: middle
            }

            .admin-table .col-id {
                width: 140px;
                text-align: center;
                font-weight: 700
            }

            .admin-table .col-act {
                width: 260px;
                text-align: center;
                white-space: nowrap
            }

                .admin-table .col-act form {
                    display: inline
                }

                .admin-table .col-act .btn {
                    padding: 2px 9px
                }
           
    </style>
</head>
<body class="admin">
    <aside class="sidebar">
        <a class="sidebar-brand" asp-controller="Admin" asp-action="Index">Lapzone Admin</a>

        <ul class="sidebar-menu">
            <li><a class="@(Active("Products"))" asp-controller="Products" asp-action="Index"><i class="fa-solid fa-laptop"></i> Quản lý sản phẩm</a></li>
            <li><a class="@(Active("Users"))" asp-controller="Users" asp-action="Index"><i class="fa-solid fa-users"></i> Quản lý khách hàng</a></li>
            <li><a class="@(Active("Orders"))" asp-controller="Orders" asp-action="Index"><i class="fa-solid fa-boxes-stacked"></i> Quản lý Đơn hàng</a></li>
            <li><a class="@(Active("Categories"))" asp-controller="Categories" asp-action="Index"><i class="fa-solid fa-tags"></i> Quản lý Danh mục</a></li>
        </ul>

        <div class="sidebar-foot">
            <a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-right-from-bracket"></i> Thoát về trang chủ</a>
        </div>
    </aside>

    <main class="admin-main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>