@model IEnumerable<Lapzone_test.Models.Product>

<style>
    .product-card {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0, 0, 0, .08);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, .15);
        }

    .product-thumb {
        display: block;
        background: #f8f9fa;
        aspect-ratio: 1 / 1;
        padding: 1rem;
    }

        .product-thumb img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .product-name {
        font-size: .98rem;
        font-weight: 600;
        line-height: 1.35;
        min-height: 2.7em; 
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

        .product-name a {
            color: #212529;
            text-decoration: none;
        }

            .product-name a:hover {
                color: #0d6efd;
            }

    .product-price {
        font-size: 1.1rem;
        font-weight: 800;
        color: #dc3545;
    }
</style>
<div class="Banner">
    <a href="#" class="banner active"><img src="~/images/banner3.jpg" alt="Banner 2" class="img-fluid"></a>
    <a href="#" class="banner"><img src="~/images/banner3.jpg" alt="Banner 3" class="img-fluid"></a>

    <button type="button" class="banner-btn prev" aria-label="Banner trước">&#10094;</button>
    <button type="button" class="banner-btn next" aria-label="Banner sau">&#10095;</button>
    <style>
            .Banner {
                position: relative;
                overflow: hidden;
            }

                .Banner .banner {
                    display: none;
                }

                    .Banner .banner.active {
                        display: block;
                    }

                .Banner img {
                    width: 100%;
                    display: block;
                    border-radius: 8px;
                }

            .banner-btn {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                width: 44px;
                height: 44px;
                border: none;
                border-radius: 50%;
                background: rgba(0, 0, 0, 0.5);
                color: #fff;
                font-size: 20px;
                cursor: pointer;
                z-index: 2;
            }

                .banner-btn:hover {
                    background: rgba(0, 0, 0, 0.8);
                }

                .banner-btn.prev {
                    left: 12px;
                }

                .banner-btn.next {
                    right: 12px;
                }
    </style>
    <script>
            const banners = document.querySelectorAll('.Banner .banner');
            let current = 0;

            function showBanner(index) {
                banners[current].classList.remove('active');
                current = (index + banners.length) % banners.length; 
                banners[current].classList.add('active');
            }

            document.querySelector('.Banner .prev').addEventListener('click', () => showBanner(current - 1));
            document.querySelector('.Banner .next').addEventListener('click', () => showBanner(current + 1));
    </script>
</div>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0" style="margin-top: 10px;">Sản phẩm theo danh mục</h3>

</div>

<style>
    .category-heading {
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 1.25rem;
    }

    .category-card {
        position: relative;
        border: none;
        border-radius: 16px;
        text-align: center;
        box-shadow: 0 2px 12px rgba(15, 23, 42, .06);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 26px rgba(13, 110, 253, .18);
        }

    .category-icon {
        width: 64px;
        height: 64px;
        margin: 1.4rem auto .9rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.9rem;
        color: var(--brand);
        background: #e7f0ff;
        transition: background-color .2s ease, color .2s ease;
    }

    .category-card .card-body {
        padding: 0 1rem 1.25rem;
    }

    .category-name {
        font-size: 1rem;
        font-weight: 700;
        color: var(--ink);
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 2.6em;
    }

    .category-card .btn {
        border-radius: 999px;
        font-weight: 600;
        padding: .4rem 1rem;
    }

    .category-card .btn-primary {
        background: var(--brand);
        border-color: var(--brand);
    }

    .category-card:hover .btn-primary {
        background: var(--brand-dark);
        border-color: var(--brand-dark);
    }

    .list_categories, .list_products {
        display : flex;
        flex-wrap: wrap;
        justify-content : space-evenly
    }
</style>
@if (ViewBag.Categories == null)
{
    <div class="alert alert-info">Hiện chưa có danh mục nào.</div>
}
else
{
    <div class="list_categories row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 row-cols-xxl-6 g-3">
        @foreach (var item in ViewBag.Categories)
        {
            <div class="col">
                <div class="card category-card h-100">
                    <div class="category-icon">
                        <i class="bi bi-laptop"></i>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h6 class="category-name">@item.Name</h6>
                        <a asp-controller="Home" asp-action="ProductsByCategories" asp-route-categoryId="@item.Id"
                           class="btn btn-primary btn-sm mt-auto stretched-link">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="fw-bold mb-0" style="margin-top: 10px;">Danh sách sản phẩm mới</h3>
    
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Hiện chưa có sản phẩm nào.</div>
}
else
{
    <div class="list_products row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 row-cols-xxl-6 g-3">
        @foreach (var item in Model)
        {
            var img = string.IsNullOrEmpty(item.Image)
                ? null
                : (item.Image.StartsWith("/") || item.Image.StartsWith("~"))
                    ? item.Image
                    : "~/images/" + item.Image;

            <div class="col">
                <div class="card product-card h-100">

                    <a class="product-thumb" asp-controller="Products" asp-action="Details" asp-route-id="@item.Id">
                        @if (img != null)
                        {
                            <img src="@Url.Content(img)" alt="@item.Name" loading="lazy" />
                        }
                        else
                        {
                            <div class="h-100 d-flex align-items-center justify-content-center text-muted small">
                                Chưa có ảnh
                            </div>
                        }
                    </a>

                    <div class="card-body d-flex flex-column">
                        <h6 class="product-name">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id">@item.Name</a>
                        </h6>

                        <div class="product-price mb-1" style="text-align : right">@item.Price.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) đ</div>

                        @if (item.Stock > 0)
                        {
                            <small class="text-success mb-3" style="text-align : right">Còn hàng (@item.Stock)</small>
                        }
                        else
                        {
                            <small class="text-danger mb-3" style="text-align : right">Hết hàng</small>
                        }

                        <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-primary btn-sm mt-auto">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
}

