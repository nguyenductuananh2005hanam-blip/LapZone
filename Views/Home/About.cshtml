@{
    ViewData["Title"] = "Về chúng tôi";
}

<style>
    .about-hero {
        background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
        color: #fff;
        border-radius: 20px;
        padding: 4rem 2rem;
        text-align: center;
        margin-bottom: 3rem;
    }

        .about-hero h1 {
            font-weight: 800;
        }

        .about-hero p {
            max-width: 640px;
            margin: 1rem auto 0;
            opacity: .92;
        }

    .section-title {
        font-weight: 700;
        margin-bottom: .5rem;
    }

    .section-sub {
        color: #6c757d;
        margin-bottom: 2rem;
    }

    .about-img {
        width: 100%;
        border-radius: 16px;
        object-fit: cover;
        box-shadow: 0 8px 30px rgba(0, 0, 0, .12);
    }

    .stat-box {
        text-align: center;
        padding: 1.5rem 1rem;
        border-radius: 16px;
        background: #f8f9fa;
    }

        .stat-box .stat-num {
            font-size: 2rem;
            font-weight: 800;
            color: #0d6efd;
        }

    .value-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, .08);
        height: 100%;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .value-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 28px rgba(0, 0, 0, .14);
        }

    .value-icon {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #e7f0ff;
        font-size: 1.6rem;
        margin-bottom: 1rem;
    }

    .team-card {
        text-align: center;
    }

        .team-card img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #fff;
            box-shadow: 0 4px 14px rgba(0, 0, 0, .15);
            margin-bottom: 1rem;
        }

    .about-cta {
        background: #f1f5ff;
        border-radius: 20px;
        padding: 3rem 2rem;
        text-align: center;
    }
</style>

<!-- Hero -->
<section class="about-hero">
    <h1>Về Lapzone</h1>
    <p>
        Lapzone mang đến những chiếc laptop chính hãng, cấu hình phù hợp và dịch vụ
        tận tâm, giúp bạn học tập, làm việc và giải trí tốt hơn mỗi ngày.
    </p>
</section>

<!-- Câu chuyện -->
<section class="row align-items-center g-4 mb-5">
    <div class="col-lg-6">
        <img src="~/images/Lapzone_logo.png" alt="Cửa hàng Lapzone" class="about-img" />
    </div>
    <div class="col-lg-6">
        <h2 class="section-title">Câu chuyện của chúng tôi</h2>
        <p class="text-muted">
            Lapzone ra đời từ mong muốn giúp mọi người chọn được chiếc laptop đúng nhu cầu
            mà không phải lo về giá cả hay chất lượng. Chúng tôi bắt đầu từ một cửa hàng nhỏ
            và không ngừng phát triển nhờ sự tin tưởng của khách hàng.
        </p>
        <p class="text-muted">
            Mỗi sản phẩm tại Lapzone đều được kiểm tra kỹ lưỡng trước khi đến tay bạn, đi kèm
            chính sách bảo hành rõ ràng và đội ngũ tư vấn luôn sẵn sàng hỗ trợ.
        </p>
    </div>
</section>

<!-- Số liệu -->
<section class="row g-3 mb-5">
    <div class="col-6 col-md-3">
        <div class="stat-box"><div class="stat-num">5+</div><div>Năm kinh nghiệm</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-box"><div class="stat-num">10.000+</div><div>Khách hàng tin dùng</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-box"><div class="stat-num">200+</div><div>Mẫu laptop</div></div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-box"><div class="stat-num">24/7</div><div>Hỗ trợ trực tuyến</div></div>
    </div>
</section>

<!-- Giá trị cốt lõi -->
<section class="mb-5">
    <div class="text-center">
        <h2 class="section-title">Vì sao chọn Lapzone?</h2>
        <p class="section-sub">Những cam kết chúng tôi luôn giữ vững</p>
    </div>
    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="card value-card">
                <div class="card-body">
                    <div class="value-icon">✅</div>
                    <h5>Hàng chính hãng</h5>
                    <p class="text-muted mb-0">Nguồn gốc rõ ràng, đầy đủ hóa đơn và tem bảo hành.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card value-card">
                <div class="card-body">
                    <div class="value-icon">💰</div>
                    <h5>Giá cả hợp lý</h5>
                    <p class="text-muted mb-0">Mức giá cạnh tranh cùng nhiều ưu đãi cho sinh viên.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card value-card">
                <div class="card-body">
                    <div class="value-icon">🚚</div>
                    <h5>Giao hàng nhanh</h5>
                    <p class="text-muted mb-0">Giao tận nơi trên toàn quốc, được kiểm tra hàng trước khi nhận.</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card value-card">
                <div class="card-body">
                    <div class="value-icon">🛠️</div>
                    <h5>Bảo hành tận tâm</h5>
                    <p class="text-muted mb-0">Hỗ trợ kỹ thuật và đổi trả nhanh chóng khi có sự cố.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Đội ngũ -->
<section class="mb-5">
    <div class="text-center">
        <h2 class="section-title">Đội ngũ của chúng tôi</h2>
        <p class="section-sub">Những người đứng sau Lapzone</p>
    </div>
    <div class="row g-4 justify-content-center">
        <div class="col-6 col-md-3 team-card">
            <img src="~/images/team1.jpg" alt="Thành viên 1" />
            <h6 class="mb-0">Nguyễn Văn A</h6>
            <small class="text-muted">Nhà sáng lập</small>
        </div>
        <div class="col-6 col-md-3 team-card">
            <img src="~/images/team2.jpg" alt="Thành viên 2" />
            <h6 class="mb-0">Trần Thị B</h6>
            <small class="text-muted">Tư vấn khách hàng</small>
        </div>
        <div class="col-6 col-md-3 team-card">
            <img src="~/images/team3.jpg" alt="Thành viên 3" />
            <h6 class="mb-0">Lê Văn C</h6>
            <small class="text-muted">Kỹ thuật viên</small>
        </div>
    </div>
</section>

<!-- Kêu gọi hành động -->
<section class="about-cta mb-4">
    <h3 class="section-title">Sẵn sàng chọn chiếc laptop cho riêng bạn?</h3>
    <p class="text-muted">Khám phá các mẫu laptop mới nhất hoặc liên hệ để được tư vấn miễn phí.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 me-2">Xem sản phẩm</a>
    <a href="mailto:contact@lapzone.vn" class="btn btn-outline-primary px-4">Liên hệ</a>
</section>