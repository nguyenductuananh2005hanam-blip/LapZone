@model IEnumerable<Lapzone_test.Models.Category>

@{
    ViewData["Title"] = "Danh mục sản phẩm";
}

<style>
    .cat-strip {
        display: flex;
        flex-wrap: nowrap;
        gap: 1rem;
        overflow-x: auto;
        padding: .5rem .25rem 1rem;
        scroll-snap-type: x proximity;
        scrollbar-width: thin;
    }

        .cat-strip::-webkit-scrollbar {
            height: 6px;
        }

        .cat-strip::-webkit-scrollbar-thumb {
            background: #ced4da;
            border-radius: 999px;
        }

    .cat-item {
        flex: 0 0 auto;
        width: 130px;
        text-align: center;
        text-decoration: none;
        color: #212529;
        padding: 1.1rem .75rem;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 4px 16px rgba(0, 0, 0, .08);
        scroll-snap-align: start;
        transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
    }

        .cat-item:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 24px rgba(13, 110, 253, .25);
            background: #f1f5ff;
            color: #0d6efd;
        }

    .cat-icon {
        width: 56px;
        height: 56px;
        margin: 0 auto .6rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e7f0ff;
        font-size: 1.6rem;
    }

    .cat-name {
        font-weight: 600;
        font-size: .95rem;
        line-height: 1.3;
        word-break: break-word;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h3 class="fw-bold mb-0">Danh mục sản phẩm</h3>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">Hiện chưa có danh mục nào.</div>
}
else
{
    <div class="cat-strip">
        @foreach (var c in Model)
        {
            <a class="cat-item" asp-controller="Product" asp-action="Index" asp-route-categoryId="@c.Id">
                <div class="cat-icon">💻</div>
                <div class="cat-name">@c.Name</div>
            </a>
        }
    </div>
}
