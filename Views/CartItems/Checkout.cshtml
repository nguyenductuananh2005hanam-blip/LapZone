@model Lapzone_test.Models.Order
@{
    ViewData["Title"] = "Thanh toán";
    var items = ViewBag.CartItems as List<Lapzone_test.Models.CartItem> ?? new List<Lapzone_test.Models.CartItem>();
    var total = items.Sum(i => i.Product.Price * i.Quantity);
}

<style>
    .co-card {
        background: #fff;
        border-radius: 16px;
        padding: 1.75rem;
        box-shadow: 0 4px 20px rgba(15, 23, 42, .08);
    }

    .co-title {
        font-size: 1.15rem;
        font-weight: 800;
        color: var(--ink);
        margin-bottom: 1.25rem;
        padding-bottom: .8rem;
        border-bottom: 1px solid #edf0f5;
    }

    .co-card label {
        display: block;
        margin-bottom: .4rem;
        font-size: .9rem;
        font-weight: 600;
        color: #475569;
    }

    .co-card .form-control {
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        padding: .65rem .9rem;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .co-card .form-control:focus {
            border-color: var(--brand);
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .12);
        }

    .co-card .field-validation-error {
        display: block;
        margin-top: .3rem;
        font-size: .82rem;
    }

    /* Tóm tắt đơn hàng */
    .co-summary {
        position: sticky;
        top: 130px;
    }

    .co-item {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding: .65rem 0;
        border-bottom: 1px dashed #e2e8f0;
        font-size: .92rem;
    }

    .co-item-name {
        font-weight: 600;
        color: var(--ink);
    }

    .co-item-qty {
        color: #64748b;
        font-size: .85rem;
    }

    .co-item-price {
        white-space: nowrap;
        font-weight: 600;
    }

    .co-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1rem;
        font-size: 1.1rem;
        font-weight: 800;
    }

        .co-total span:last-child {
            color: #dc3545;
            font-size: 1.3rem;
        }

    .co-pay {
        background: #f1f5f9;
        border-radius: 10px;
        padding: .75rem 1rem;
        font-size: .9rem;
        color: #475569;
        margin-top: 1rem;
    }

    .co-btn {
        width: 100%;
        margin-top: 1.25rem;
        border-radius: 999px;
        padding: .75rem 1rem;
        font-weight: 700;
        background: var(--brand);
        border-color: var(--brand);
    }

        .co-btn:hover {
            background: var(--brand-dark);
            border-color: var(--brand-dark);
        }
</style>

<h2 class="fw-bold mb-4" style="color:var(--ink)">Thanh toán</h2>

<form asp-action="Checkout" method="post" id="checkoutForm">
    <div class="row g-4">

        <!-- Thông tin giao hàng -->
        <div class="col-lg-7">
            <div class="co-card">
                <h5 class="co-title"><i class="bi bi-truck me-2 text-primary"></i>Thông tin giao hàng</h5>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="CustomerName"><i class="bi bi-person me-2 text-primary"></i>Họ và tên</label>
                    <input asp-for="CustomerName" name="name" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" required />
                    <span asp-validation-for="CustomerName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CustomerPhone"><i class="bi bi-telephone me-2 text-primary"></i>Số điện thoại</label>
                    <input asp-for="CustomerPhone" name="phone" class="form-control" placeholder="Ví dụ: 0987654321"
                           required pattern="[0-9]{9,11}" title="Số điện thoại " />
                    <span asp-validation-for="CustomerPhone" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address"><i class="bi bi-geo-alt me-2 text-primary"></i>Địa chỉ nhận hàng</label>
                    <input asp-for="Address" name="address" class="form-control" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành" required />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                <div class="co-pay">
                    <i class="bi bi-cash-coin me-2"></i>Thanh toán khi nhận hàng (COD)
                </div>
            </div>
        </div>

        <!-- Tóm tắt đơn hàng -->
        <div class="col-lg-5">
            <div class="co-card co-summary">
                <h5 class="co-title"><i class="bi bi-bag-check me-2 text-primary"></i>Đơn hàng của bạn</h5>

                @foreach (var item in items)
                {
                    <div class="co-item">
                        <div>
                            <div class="co-item-name">@item.Product.Name</div>
                            <div class="co-item-qty">@item.Product.Price.ToString("N0") đ × @item.Quantity</div>
                        </div>
                        <div class="co-item-price">@((item.Product.Price * item.Quantity).ToString("N0")) đ</div>
                    </div>
                }

                <div class="co-total">
                    <span>Tổng cộng</span>
                    <span>@total.ToString("N0") đ</span>
                </div>

                <button type="submit" class="btn btn-primary co-btn" id="btnPlaceOrder">
                    <i class="bi bi-check-circle me-1"></i>Đặt hàng
                </button>
                <a asp-action="Index" class="btn btn-link w-100 mt-2 text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại giỏ hàng
                </a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Chặn bấm "Đặt hàng" nhiều lần gây tạo trùng đơn
        document.getElementById('checkoutForm').addEventListener('submit', function() {
            var btn = document.getElementById('btnPlaceOrder');
            if (this.checkValidity()) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...';
            }
        });
    </script>
}