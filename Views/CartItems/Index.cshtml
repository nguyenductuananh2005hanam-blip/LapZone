@model IEnumerable<Lapzone_test.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container mt-4">
    <h3 class="mb-3">Giỏ hàng</h3>

    @if (!Model.Any())
    {
        <p>Giỏ hàng đang trống.</p>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>Đơn giá</th>
                    <th style="width:160px">Số lượng</th>
                    <th>Thành tiền</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Product.Name</td>
                        <td>@item.Product.Price.ToString("N0") đ</td>
                        <td>
                            <form asp-action="UpdateQuantity" method="post" class="d-inline-flex align-items-center">
                                <input type="hidden" name="id" value="@item.Id" />

                                <button type="submit" name="quantity" value="@(item.Quantity - 1)"
                                        class="btn btn-sm btn-outline-secondary" @(item.Quantity <= 1 ? "disabled" : "")>
                                    <i class="bi bi-dash"></i>
                                </button>

                                <span class="px-3 fw-semibold">@item.Quantity</span>

                                <button type="submit" name="quantity" value="@(item.Quantity + 1)"
                                        class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-plus"></i>
                                </button>
                            </form>
                        </td>
                        <td>@((item.Product.Price * item.Quantity).ToString("N0")) đ</td>
                        <td>
                            <form asp-action="Remove" method="post"
                                  onsubmit="return confirm('Xóa sản phẩm này khỏi giỏ hàng?')">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Tổng cộng:</th>
                    <th colspan="2">@Model.Sum(i => i.Product.Price * i.Quantity).ToString("N0") đ</th>
                </tr>
                <tr>
                    <th colspan="5" class="text-end">
                        <a asp-action="Checkout" class="btn btn-success">Thanh toán ngay</a>
                    </th>
                </tr>
            </tfoot>
        </table>
    }
</div>